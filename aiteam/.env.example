# ── Anthropic API ──────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Circuit Breaker ────────────────────────────────────────────────────────────
# Per-session USD spend limit. Overridden by budget_usd in SPEC.md frontmatter.
AI_SESSION_BUDGET_USD=2.00

# ── Optional: Redis (for cross-process circuit breaker state) ──────────────────
# Cost store backend: "file" (default, single-process, writes the local
# .beads/session.local.json — never committed) or "redis" (atomic counter shared
# across concurrent agent processes, mirrored into the same local file).
# AI_COST_STORE=redis
# REDIS_URL=redis://localhost:6379
# AI_SESSION_ID=default   # redis key namespace; one shared budget per id

# ── Optional: Langfuse Observability ───────────────────────────────────────────
# Run: docker compose -f aiteam/docker-compose.yml --profile observability up -d
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001
